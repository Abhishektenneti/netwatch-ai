{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProcessedEvent",
  "description": "Enriched event after anomaly detection",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "device_id",
    "anomaly_score",
    "is_anomaly"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "device_id": { "type": "string" },
    "src_ip": { "type": "string" },
    "dst_ip": { "type": "string" },
    "protocol": { "type": "string" },
    "bytes_sent": { "type": "integer" },
    "bytes_received": { "type": "integer" },
    "packets": { "type": "integer" },
    "duration_ms": { "type": "integer" },
    "anomaly_score": { "type": "number" },
    "is_anomaly": { "type": "boolean" },
    "rolling_stats": {
      "type": "object",
      "properties": {
        "mean_bytes_sent": { "type": "number" },
        "std_bytes_sent": { "type": "number" },
        "mean_bytes_received": { "type": "number" },
        "std_bytes_received": { "type": "number" },
        "mean_duration_ms": { "type": "number" },
        "event_count": { "type": "integer" }
      }
    },
    "explanation": { "type": "string" }
  }
}
